{
  "color": {
    "Black": {
      "$type": "color",
      "$value": "#131517",
      "$description": "Primary text, headings, borders, and links across the entire page"
    },
    "White": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Page background, card surfaces, hero overlay, and CTA button text"
    },
    "Cranberry / Pink": {
      "$type": "color",
      "$value": "#de475e",
      "$description": "Accent color used in headline gradient ('start here' pink word) and button/link highlights"
    },
    "Gray 60": {
      "$type": "color",
      "$value": "#939597",
      "$description": "Subtle borders, secondary link text, and divider lines"
    },
    "Gray 90": {
      "$type": "color",
      "$value": "#333537",
      "$description": "Secondary text and muted link states"
    }
  },
